rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function memberPath(campaignId, userId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/members/$(userId);
    }

    function isCampaignMember(campaignId) {
      return signedIn() &&
        request.auth.uid in get(campaignPath(campaignId)).data.memberIds;
    }

    function isCampaignDm(campaignId) {
      return signedIn() &&
        get(campaignPath(campaignId)).data.dmId == request.auth.uid;
    }

    function canManageHeroes(campaignId) {
      return isCampaignDm(campaignId) || (
        exists(memberPath(campaignId, request.auth.uid)) &&
        get(memberPath(campaignId, request.auth.uid)).data.canManageHeroes == true
      );
    }

    function onlyChangesSheetCampaignLink() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['campaignId', 'campaignName', 'data', 'updatedAt']) &&
        request.resource.data.data.diff(resource.data.data).affectedKeys()
          .hasOnly(['campaignId', 'campaignName']);
    }

    function onlyChangesCharacterVitals() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['data', 'updatedAt']) &&
        request.resource.data.data.diff(resource.data.data).affectedKeys()
          .hasOnly(['character']) &&
        request.resource.data.data.character.diff(resource.data.data.character)
          .affectedKeys().hasOnly([
            'hpCurrent', 'hpTemp', 'heroicInspiration', 'deathSaves'
          ]);
    }

    // Fichas de Personagem: Leitura liberada para membros da campanha vinculada
    match /users/{userId}/characterSheets/{sheetId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || (
          resource.data.campaignId != null &&
          isCampaignMember(resource.data.campaignId)
        )
      );
      allow create, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId || (
          resource.data.campaignId != null &&
          canManageHeroes(resource.data.campaignId) &&
          request.resource.data.campaignId == null &&
          onlyChangesSheetCampaignLink()
        ) || (
          resource.data.campaignId != null &&
          isCampaignDm(resource.data.campaignId) &&
          request.resource.data.campaignId == resource.data.campaignId &&
          onlyChangesCharacterVitals()
        )
      );
    }

    // Fichas de Monstro / NPC: Leitura liberada para membros da campanha vinculada
    match /users/{userId}/monsterSheets/{sheetId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || (
          resource.data.campaignId != null &&
          isCampaignMember(resource.data.campaignId)
        )
      );
      allow create, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId || (
          resource.data.campaignId != null &&
          isCampaignDm(resource.data.campaignId) &&
          request.resource.data.campaignId == null &&
          onlyChangesSheetCampaignLink()
        )
      );
    }

    // Cada usuário só pode ler e escrever seus demais dados e subcoleções privadas.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    // Campanhas (Mesas de RPG) e Membros
    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.dmId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.dmId == request.auth.uid || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'updatedAt']) &&
          (
            (
              !(request.auth.uid in resource.data.memberIds) &&
              request.auth.uid in request.resource.data.memberIds &&
              request.resource.data.memberIds.toSet()
                .difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid]) &&
              resource.data.memberIds.toSet()
                .difference(request.resource.data.memberIds.toSet()).size() == 0
            ) || (
              request.auth.uid in resource.data.memberIds &&
              !(request.auth.uid in request.resource.data.memberIds) &&
              resource.data.memberIds.toSet()
                .difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid]) &&
              request.resource.data.memberIds.toSet()
                .difference(resource.data.memberIds.toSet()).size() == 0
            ) || (
              request.auth.uid in resource.data.memberIds &&
              request.auth.uid in request.resource.data.memberIds &&
              request.resource.data.memberIds == resource.data.memberIds
            )
          )
        )
      );
      allow delete: if signedIn() && resource.data.dmId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if signedIn() && (
          isCampaignDm(campaignId) || (
            request.auth.uid == memberId &&
            request.resource.data.role == 'player'
          )
        );
        allow update: if signedIn() && (
          isCampaignDm(campaignId) || (
            request.auth.uid == memberId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'characterSheetId', 'characterName',
              'characterClass', 'characterAvatarUrl', 'vitals'
            ])
          ) || (
            request.auth.uid != memberId &&
            canManageHeroes(campaignId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'characterSheetId', 'characterName', 'characterClass',
              'characterAvatarUrl', 'vitals'
            ]) &&
            request.resource.data.characterSheetId == null &&
            request.resource.data.characterName == null &&
            request.resource.data.characterClass == null &&
            request.resource.data.characterAvatarUrl == null &&
            request.resource.data.vitals == null
          )
        );
        allow delete: if signedIn() && (
          request.auth.uid == memberId || isCampaignDm(campaignId)
        );
      }
    }

  }
}
