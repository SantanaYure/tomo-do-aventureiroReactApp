# Credenciais do Firebase (Vite expõe apenas variáveis prefixadas com VITE_)
# Copie este arquivo para `.env` e preencha com os valores do Console do Firebase:
#   Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration
#
# O `.env` é ignorado pelo git (ver .gitignore) e NUNCA deve ser commitado.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
